{
  "id": "human-engine",
  "name": "Human Engine",
  "version": "0.5.0",
  "description": "Local human-like conversation engine for OpenClaw: turn-taking, naturalization, voice, persona, social memory \u2014 fully self-hosted.",
  "activation": {
    "onStartup": true
  },
  "configSchema": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "enabled": { "type": "boolean", "default": true },
      "agents": { "type": "array", "items": { "type": "string" }, "default": [] },
      "agentProfiles": {
        "type": "object",
        "additionalProperties": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "agentName": { "type": "string" },
            "agentAliases": { "type": "array", "items": { "type": "string" } },
            "language": { "type": "string" },
            "contactsPath": { "type": "string" },
            "soulPath": { "type": "string" },
            "soulAutoEnhance": { "type": "boolean" },
            "socialLearning": { "type": "object" },
            "selfVoice": { "type": "object" },
            "socialMemory": { "type": "object" },
            "proactive": { "type": "object" },
            "dmProactive": { "type": "object" },
            "mood": { "type": "object" },
            "naturalize": { "type": "object" },
            "timing": { "type": "object" },
            "humanize": { "type": "object" },
            "decide": { "type": "object" },
            "threads": { "type": "object" },
            "reactions": { "type": "object" },
            "initiative": { "type": "object" }
          }
        },
        "default": {}
      },
      "agentName": { "type": "string", "default": "OpenClaw" },
      "agentAliases": { "type": "array", "items": { "type": "string" }, "default": [], "description": "Additional names the agent is called by (e.g. its former name) — used for hard-trigger mention detection" },
      "language": { "type": "string", "default": "de", "description": "Conversation-layer language pack code. 'de' is the byte-identical default. Agent profiles may override it per-agent." },
      "soulPath": { "type": "string", "default": "" },
      "contactsPath": { "type": "string", "default": "" },
      "soulAutoEnhance": { "type": "boolean", "default": true },
      "antiTell": { "type": "boolean", "default": true },
      "styleStats": { "type": "boolean", "default": true },
      "selfVoice": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "enabled": { "type": "boolean", "default": false },
          "refreshMinutes": { "type": "number", "default": 60 },
          "minVolume": { "type": "number", "default": 30 }
        },
        "default": {}
      },
      "socialLearning": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "enabled": { "type": "boolean", "default": true },
          "perSessionCard": { "type": "boolean", "default": true },
          "refreshEvery": { "type": "number", "default": 5 },
          "refreshMinutes": { "type": "number", "default": 0 },
          "window": { "type": "number", "default": 100 },
          "logRequests": { "type": "boolean", "default": false }
        },
        "default": {}
      },
      "socialMemory": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "enabled": { "type": "boolean", "default": true },
          "extractEvery": { "type": "number", "default": 25 },
          "extractMinutes": { "type": "number", "default": 0 },
          "maxPeople": { "type": "number", "default": 50 },
          "recallLimit": { "type": "number", "default": 800 },
          "personStore": { "type": "boolean", "default": false },
          "schemaV2": { "type": "boolean", "default": false }
        },
        "default": {}
      },
      "autoconfig": { "type": "boolean", "default": false },
      "decide": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "temperature": { "type": "number", "default": 0.2 },
          "v2Contract": { "type": "boolean", "default": false }
        },
        "default": {}
      },
      "humanize": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "maxBubbles": { "type": "number", "default": 5 },
          "temperature": { "type": "number", "default": 0.9 }
        },
        "default": {}
      },
      "naturalize": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "speakEpochTtlMs": { "type": "number", "default": 300000 },
          "disableDM": { "type": "boolean", "default": false }
        },
        "default": {}
      },
      "timing": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "typingWpm": { "type": "number", "default": 40 },
          "maxTypingMs": { "type": "number", "default": 60000 },
          "maxBubbleGapMs": { "type": "number", "default": 3000 },
          "nightMode": { "type": "boolean", "default": true }
        },
        "default": {}
      },
      "proactive": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "enabled": { "type": "boolean", "default": false },
          "shadow": { "type": "boolean", "default": true },
          "budgetPerDay": { "type": "number", "default": 2 },
          "recognitionBudgetPerDay": { "type": "number", "default": 1 },
          "returnGreetingBudgetPerDay": { "type": "number", "default": 1 },
          "threadCallbackMinAgeHours": { "type": "number", "default": 20 },
          "minGapMinutes": { "type": "number", "default": 180 },
          "quietStart": { "type": "string", "default": "23:00" },
          "quietEnd": { "type": "string", "default": "07:00" },
          "probability": { "type": "number", "default": 0.5 },
          "cooldownBaseMinutes": { "type": "number", "default": 180 },
          "triggers": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "unansweredQuestion": { "type": "boolean", "default": true },
              "stalledExchange": { "type": "boolean", "default": true },
              "contextMatch": { "type": "boolean", "default": true },
              "followUpCommitment": { "type": "boolean", "default": true },
              "outcomeCelebration": { "type": "boolean", "default": true },
              "checkInOnPromise": { "type": "boolean", "default": true },
              "returnGreeting": { "type": "boolean", "default": false },
              "threadCallback": { "type": "boolean", "default": false }
            },
            "default": {}
          }
        },
        "default": {}
      },
      "dmProactive": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "agents": { "type": "array", "items": { "type": "string" }, "default": [] },
          "enabled": { "type": "boolean", "default": false },
          "shadow": { "type": "boolean", "default": true },
          "budgetPerDay": { "type": "number", "default": 2 },
          "minGapMinutes": { "type": "number", "default": 180 },
          "quietStart": { "type": "string", "default": "23:00" },
          "quietEnd": { "type": "string", "default": "07:00" },
          "careBudgetPerDay": { "type": "number", "default": 1 },
          "dayFitReduceHours": { "type": "number", "default": 4 },
          "dayFitPauseHours": { "type": "number", "default": 12 },
          "dayFitActivityPath": { "type": "string", "default": "" },
          "inferredCapPerDay": { "type": "number", "default": 2 }
        },
        "default": {}
      },
      "mood": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "enabled": { "type": "boolean", "default": false },
          "groupsEnabled": { "type": "boolean", "default": false },
          "groupsRefreshEvery": { "type": "number", "default": 10 },
          "refreshEvery": { "type": "number", "default": 5 },
          "refreshMinutes": { "type": "number", "default": 0 },
          "decayHours": { "type": "number", "default": 6 },
          "maxShiftPerUpdate": { "type": "number", "default": 1 }
        },
        "default": {}
      },
      "threads": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "enabled": { "type": "boolean", "default": false },
          "absenceThresholdHours": { "type": "number", "default": 24 },
          "topicExpiryDays": { "type": "number", "default": 14 }
        },
        "default": {}
      },
      "reactions": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "hintEnabled": { "type": "boolean", "default": false }
        },
        "default": {}
      },
      "initiative": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "enabled": { "type": "boolean", "default": false },
          "shadow": { "type": "boolean", "default": true },
          "agents": { "type": "array", "items": { "type": "string" }, "default": [] },
          "scopes": { "type": "array", "items": { "type": "string" }, "default": ["group"] },
          "everyMinutes": { "type": "number", "default": 60 },
          "activeHours": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "start": { "type": "string", "default": "08:00" },
              "end": { "type": "string", "default": "22:00" },
              "timezone": { "type": "string", "default": "Europe/Berlin" }
            },
            "default": {}
          },
          "quietStart": { "type": "string", "default": "22:00" },
          "quietEnd": { "type": "string", "default": "07:00" },
          "maxActsPerDay": { "type": "number", "default": 2 },
          "minGapMinutes": { "type": "number", "default": 240 },
          "minGapAfterAgentSpeakMinutes": { "type": "number", "default": 30 },
          "hotWindowMinutes": { "type": "number", "default": 15 },
          "capture": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "keywords": { "type": "boolean", "default": true },
              "everyMessages": { "type": "number", "default": 20 },
              "everyMinutes": { "type": "number", "default": 0 }
            },
            "default": {}
          },
          "firstNudgeMinutes": { "type": "number", "default": 120 },
          "taskExpiryDays": { "type": "number", "default": 30 },
          "probability": { "type": "number", "default": 0.8 },
          "cooldownBaseMinutes": { "type": "number", "default": 240 },
          "directives": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "enabled": { "type": "boolean", "default": true },
              "maxPerScope": { "type": "number", "default": 10 }
            },
            "default": {}
          },
          "maxContextChars": { "type": "number", "default": 600 },
          "maxOpenTasks": { "type": "number", "default": 20 }
        },
        "default": {}
      }
    }
  }
}
