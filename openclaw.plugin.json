{
  "id": "human-engine",
  "name": "Human Engine",
  "version": "0.2.1",
  "description": "Local human-like conversation engine for OpenClaw: turn-taking, naturalization, voice, persona, social memory \u2014 fully self-hosted.",
  "activation": {
    "onStartup": true
  },
  "configSchema": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "enabled": { "type": "boolean", "default": true },
      "agents": { "type": "array", "items": { "type": "string" }, "default": [] },
      "agentName": { "type": "string", "default": "OpenClaw" },
      "soulPath": { "type": "string", "default": "" },
      "soulAutoEnhance": { "type": "boolean", "default": true },
      "antiTell": { "type": "boolean", "default": true },
      "styleStats": { "type": "boolean", "default": true },
      "socialLearning": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "enabled": { "type": "boolean", "default": true },
          "perSessionCard": { "type": "boolean", "default": false },
          "refreshEvery": { "type": "number", "default": 5 },
          "refreshMinutes": { "type": "number", "default": 0 },
          "window": { "type": "number", "default": 100 },
          "logRequests": { "type": "boolean", "default": false }
        },
        "default": {}
      },
      "socialMemory": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "enabled": { "type": "boolean", "default": true },
          "extractEvery": { "type": "number", "default": 25 },
          "extractMinutes": { "type": "number", "default": 0 },
          "maxPeople": { "type": "number", "default": 50 },
          "recallLimit": { "type": "number", "default": 800 }
        },
        "default": {}
      },
      "autoconfig": { "type": "boolean", "default": false },
      "gate": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "silentTtlMs": { "type": "number", "default": 90000 }
        },
        "default": {}
      },
      "decide": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "model": { "type": "string", "default": "" },
          "temperature": { "type": "number", "default": 0.2 }
        },
        "default": {}
      },
      "humanize": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "model": { "type": "string", "default": "" },
          "maxBubbles": { "type": "number", "default": 5 },
          "temperature": { "type": "number", "default": 0.9 }
        },
        "default": {}
      },
      "timing": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "typingWpm": { "type": "number", "default": 40 },
          "maxTypingMs": { "type": "number", "default": 60000 },
          "nightMode": { "type": "boolean", "default": true }
        },
        "default": {}
      }
    }
  }
}
